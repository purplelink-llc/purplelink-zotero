{
  "name": "purplelink-zotero",
  "type": "module",
  "version": "0.1.0",
  "description": "Check a manuscript's citations for gaps directly from Zotero, using Purplelink's Citation Gap tool.",
  "config": {
    "addonName": "Purplelink Citation Gap",
    "addonID": "purplelink-zotero@purplelink.llc",
    "addonRef": "purplelinkzotero",
    "addonInstance": "PurplelinkZotero",
    "prefsPrefix": "extensions.zotero.purplelinkzotero"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplelink-llc/purplelink-zotero.git"
  },
  "author": "Purplelink LLC",
  "bugs": {
    "url": "https://github.com/purplelink-llc/purplelink-zotero/issues"
  },
  "homepage": "https://purplelink.llc/tools/citation-gap/",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^9.39.2",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
